{
  "manifest_version": 3,
  "name": "Web Relay Launcher",
  "version": "0.0.1",
  "description": "Discover local PWA, GitHub provider, and browser actions.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Web Relay"
  },
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Space"
      },
      "description": "Open Web Relay"
    }
  }
}
