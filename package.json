{
  "name": "web-relay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev:pwa": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs",
    "test:e2e": "node tests/showcase.mjs && node tests/overlay.mjs && node tests/sdk-extension.mjs && node tests/pairing.mjs && node tests/pwa-pairing.mjs && node tests/webmcp.mjs && node tests/webmcp-sites.mjs",
    "build:sdk": "node scripts/build-sdk.mjs",
    "pack:sdk": "node scripts/pack-sdk.mjs",
    "test:sdk": "node tests/sdk-package.mjs",
    "test:hub": "node tests/pwa-pairing.mjs --live-hub"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  }
}
